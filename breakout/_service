<services>
  <service name="tar_scm">
    <param name="scm">git</param>
    <param name="url">https://github.com/Kardbord/breakout.git</param>
    <param name="revision">main</param>
    <param name="filename">breakout</param>
    <param name="versionformat">%h</param>
