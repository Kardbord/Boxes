#!/bin/sh
# activate-kardbord-env — Set up PATH for io.github.kardbord.tool extensions,
# then exec the given command.
#
# Usage:
#   activate-kardbord-env /app/bin/real-app "$@"
#
# Extension binaries may appear at both /usr/lib/kardbord-tools/ and
# /app/lib/kardbord-tools/ when an app redeclares an extension point that
# already exists in the SDK. Flatpak bind-mounts the same extension files
# at both locations. We iterate /usr first, then /app, so /app paths are
# prepended last and take precedence in PATH. The binaries are identical,
# so either would work, but this avoids surprising behavior if an app ever
# ships a different version.

for _dir in /usr/lib/kardbord-tools/*/bin /app/lib/kardbord-tools/*/bin; do
	[ -d "$_dir" ] && PATH="$_dir:$PATH"
done
export PATH
unset _dir

# Exec the given command
exec "$@"
