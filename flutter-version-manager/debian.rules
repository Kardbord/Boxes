#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

# Nothing to build: upstream ships a prebuilt Dart AOT binary.
override_dh_auto_build:

# Do not strip the binary; stripping a Dart AOT executable is untested
# upstream and the snapshot data lives in ELF sections.
override_dh_strip:

# Payload sources (see the .dsc):
# - amd64: the orig tarball IS the x64 release asset; dpkg-source has
#   already extracted it, so the binary is available at fvm/fvm directly.
# - arm64/armhf: the per-arch tarball is attached into the tree by
#   debtransform (DEBTRANSFORM-FILES), but the attachment location has
#   differed between debtransform versions: debian/fvm-linux-<arch>.tar.gz
#   (remapped) or the verbatim source name at the top level, e.g.
#   debian.fvm-linux-<arch>.tar.gz. Locate it wherever it landed (the
#   copies carry identical bytes, so any match is equivalent), then
#   extract — this overwrites the orig's fvm/fvm with the matching
#   binary, which install then picks up.
override_dh_auto_install:
ifeq ($(DEB_HOST_ARCH),amd64)
	install -D -m 755 fvm/fvm debian/flutter-version-manager/usr/bin/fvm
else ifeq ($(DEB_HOST_ARCH),arm64)
	tar -xzf $$(find . -name '*fvm-linux-arm64.tar.gz' | head -n1)
	install -D -m 755 fvm/fvm debian/flutter-version-manager/usr/bin/fvm
else
	tar -xzf $$(find . -name '*fvm-linux-arm.tar.gz' | head -n1)
	install -D -m 755 fvm/fvm debian/flutter-version-manager/usr/bin/fvm
endif
	install -D -m 644 $$(find . \( -name 'fvm-LICENSE' -o -name 'debian.fvm-LICENSE' \) | head -n1) \
	  debian/flutter-version-manager/usr/share/doc/flutter-version-manager/LICENSE
