<!-- OBS service definition for this package.

     This file exists in two forms: _service.in is the template with
     placeholders, and _service is the rendered result used by OBS.
     Edit _service.in and re-run scripts/sync-obs-services.sh; the
     rendered values come from the pinned version and sha256 checksums
     in .upstream.yml (kept current by the FEDC workflow).

     The placeholder syntax (version and per-file checksums) is
     documented in docs/OBS-MAINTENANCE.md under "Prebuilt-Binary
     Packages". Note that placeholder substitution applies to the whole
     template, including comments. -->
<services>
  <!-- Server-side services (no mode attribute): run when scmsync picks up
       a push, like obs_scm does for source-built packages. The pinned URLs
       and checksums below are rewritten by scripts/sync-obs-services.sh. -->
  <service name="download_url">
    <param name="protocol">https</param>
    <param name="host">github.com</param>
    <param name="path">btwld/fvm/releases/download/{{UPSTREAM_VERSION}}/fvm-{{UPSTREAM_VERSION}}-linux-x64.tar.gz</param>
  </service>
  <service name="download_url">
    <param name="protocol">https</param>
    <param name="host">github.com</param>
    <param name="path">btwld/fvm/releases/download/{{UPSTREAM_VERSION}}/fvm-{{UPSTREAM_VERSION}}-linux-arm64.tar.gz</param>
  </service>
  <service name="download_url">
    <param name="protocol">https</param>
    <param name="host">github.com</param>
    <param name="path">btwld/fvm/releases/download/{{UPSTREAM_VERSION}}/fvm-{{UPSTREAM_VERSION}}-linux-arm.tar.gz</param>
  </service>
  <service name="download_url">
    <!-- Upstream license text; not covered by verify_file because it has
         no entry (and thus no checksum) in .upstream.yml. -->
    <param name="protocol">https</param>
    <param name="host">raw.githubusercontent.com</param>
    <param name="path">btwld/fvm/{{UPSTREAM_VERSION}}/LICENSE</param>
    <param name="filename">fvm-LICENSE</param>
  </service>
  <!-- Verify the downloaded release assets before anything is built.
       The file params must use the "_service:download_url:"-prefixed
       names: on the OBS server, bs_service renames each service's output
       with that prefix between service runs, so the plain names do not
       exist while verify_file executes. (Checksum placeholder keys stay
       plain filenames; they match the .upstream.yml entries.) -->
  <service name="verify_file">
    <param name="file">_service:download_url:fvm-{{UPSTREAM_VERSION}}-linux-x64.tar.gz</param>
    <param name="verifier">sha256</param>
    <param name="checksum">{{SHA256:fvm-{{UPSTREAM_VERSION}}-linux-x64.tar.gz}}</param>
  </service>
  <service name="verify_file">
    <param name="file">_service:download_url:fvm-{{UPSTREAM_VERSION}}-linux-arm64.tar.gz</param>
    <param name="verifier">sha256</param>
    <param name="checksum">{{SHA256:fvm-{{UPSTREAM_VERSION}}-linux-arm64.tar.gz}}</param>
  </service>
  <service name="verify_file">
    <param name="file">_service:download_url:fvm-{{UPSTREAM_VERSION}}-linux-arm.tar.gz</param>
    <param name="verifier">sha256</param>
    <param name="checksum">{{SHA256:fvm-{{UPSTREAM_VERSION}}-linux-arm.tar.gz}}</param>
  </service>
  <!-- Buildtime service: rewrites Version: in the .spec, .dsc, and
       debian.changelog from the pinned version above. -->
  <service mode="buildtime" name="set_version">
    <param name="version">{{UPSTREAM_VERSION}}</param>
  </service>
</services>
<!-- vim: set ft=xml: -->
